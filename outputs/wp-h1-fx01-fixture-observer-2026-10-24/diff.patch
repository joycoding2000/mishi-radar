+      </div>
+
+      <details class="h1-history">
+        <summary>版本历史（{{ entry.versions|length }}）</summary>
+        <div class="table-wrap">
+          <table class="data-table">
+            <thead><tr><th>版本</th><th>证券</th><th>数量</th><th>平均成本</th><th>基准日</th><th>规则</th><th>备注</th><th>记录时间</th></tr></thead>
+            <tbody>
+              {% for version in entry.versions %}
+              <tr>
+                <td>V{{ version.version }}</td>
+                <td><b>{{ version.security_name }}</b><br><span class="mono small">{{ version.security_id }}</span></td>

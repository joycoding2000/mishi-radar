diff --git a/mishi_radar/demo/templates/h1.html b/mishi_radar/demo/templates/h1.html
new file mode 100644
index 0000000..e70d23f
--- /dev/null
+++ b/mishi_radar/demo/templates/h1.html
@@ -0,0 +1,353 @@
+{% extends "base.html" %}
+{% block title %}观察仓 H1{% endblock %}
+{% block content %}
+<section class="page-head">
+  <div>
+    <p class="eyebrow">H1 静态观察仓 · 固定 Fixture</p>
+    <h1>手工持仓观察</h1>
+    <p class="lead">固定演示用户 <code>{{ user }}</code>。输入证券、数量、平均成本与成本基准日期，按合成原始参考价显示静态市值、浮盈与浮盈率；关联规则只验证默认 S01，且不会自动结束记录。</p>
+  </div>
+  <div class="batch-card">
+    <span class="pill pill-good">H1 独立存储</span>
+    <p class="small">H1 与 F5 关注分别使用独立 JSON 文件，互不覆盖。</p>
+    <p class="small muted">更正创建新版本；结束保存当时快照，之后只读。</p>
+    <p class="small mono">{{ fixture.fixture_id }} · {{ fixture.fixture_version }}</p>
+    <p class="small mono">价格口径 {{ fixture.price_basis }} · 业务日 {{ fixture.business_date }}</p>
+  </div>
+</section>
+
+<section class="notice fixture-notice">
+  <strong>{{ display_marker }}</strong>
+  <span>本页只使用固定合成 Fixture 与固定演示用户；不连接券商、不读取实时行情、不声明真实持仓或账户权益。快照身份为 <span class="mono">{{ marker }}</span>。</span>
+</section>
+
+{% if notice_created %}
+<section class="notice"><strong>已创建观察</strong><span>新记录为 ACTIVE；参考价与规则状态按当前固定 Fixture 显示。</span></section>
+{% endif %}
+{% if notice_corrected %}
+<section class="notice"><strong>已保存更正</strong><span>新版本仍为 ACTIVE；旧版本保留在版本历史中，不伪装成成交。</span></section>
+{% endif %}
+{% if notice_ended %}
+<section class="notice"><strong>已结束观察</strong><span>结束快照已保存，记录只读；如需再次观察，请创建新记录。</span></section>
+{% endif %}
+
+<section class="controls">
+  <div class="section-head h1-section-head">
+    <div>
+      <h2>创建观察</h2>
+      <p class="muted">数量与平均成本必须为有限正数；允许不足一手的零股，不套用回测最小买入单位。</p>
+    </div>
+    <span class="pill pill-neutral">固定用户 {{ user }}</span>
+  </div>
+  <form method="post" action="/h1/create" class="h1-form">
+    <div class="h1-form-grid">
+      <div class="form-field">
+        <label for="create-security">证券</label>
+        <select id="create-security" name="security_id" required>
+          {% for option in security_options %}
+            <option value="{{ option.security_id }}" {{ 'selected' if option.selected else '' }}>{{ option.security_id }} · {{ option.name }}</option>
+          {% endfor %}
+        </select>
+      </div>
+      <div class="form-field">
+        <label for="create-scenario">固定 Fixture 场景</label>
+        <select id="create-scenario" name="scenario" required>
+          {% for option in scenario_options %}
+            <option value="{{ option.value }}" {{ 'selected' if option.selected else '' }}>{{ option.label }}</option>
+          {% endfor %}
+        </select>
+        <small class="muted">场景决定参考价与日终输入；创建后不可更改。</small>
+      </div>
+      <div class="form-field">
+        <label for="create-strategy">关联规则（可选）</label>
+        <select id="create-strategy" name="strategy_id">
+          {% for option in strategy_options %}
+            <option value="{{ option.value }}" {{ 'selected' if option.selected else '' }}>{{ option.label }}</option>
+          {% endfor %}
+        </select>
+      </div>
+      <div class="form-field">
+        <label for="create-quantity">数量（股）</label>
+        <input id="create-quantity" name="quantity" type="number" inputmode="decimal" min="0.0001" step="0.0001" required placeholder="例如 100">
+      </div>
+      <div class="form-field">
+        <label for="create-cost">平均成本（元/股）</label>
+        <input id="create-cost" name="average_cost" type="number" inputmode="decimal" min="0.0001" step="0.0001" required placeholder="例如 10">
+      </div>
+      <div class="form-field">
+        <label for="create-basis">成本基准日期</label>
+        <input id="create-basis" name="cost_basis_date" type="date" max="{{ today }}" value="{{ default_basis_date }}" required>
+        <small class="muted">不得在未来；持有交易日按固定 Fixture 日历计数。</small>
+      </div>
+      <div class="form-field h1-form-wide">
+        <label for="create-note">备注（可选）</label>
+        <input id="create-note" name="note" type="text" maxlength="200" placeholder="例如 手工记录，非券商持仓">
+      </div>
+    </div>
+    <div class="form-actions">
+      <button class="button" type="submit">创建观察</button>
+      <span class="small muted">创建只记录观察，不产生成交、费用或账户权益。</span>
+    </div>
+  </form>
+</section>
+
+<section class="summary-strip">
+  <div><span class="metric-value">{{ active_count }}</span><span class="metric-label">ACTIVE 观察</span></div>
+  <div><span class="metric-value">{{ ended_count }}</span><span class="metric-label">ENDED 只读记录</span></div>
+  <div><span class="metric-value">{{ fixture.business_date }}</span><span class="metric-label">固定业务日</span></div>
+  <div><span class="metric-value">S01</span><span class="metric-label">唯一可选关联规则</span></div>
+</section>
+
+{% if active %}
+<section class="section-head">
+  <div>
+    <h2>当前观察（{{ active_count }}）</h2>
+    <p class="muted">静态估值按固定原始价计算；规则 TRUE 只是提示，不会自动结束记录。</p>
+  </div>
+</section>
+<div class="watch-list">
+  {% for entry in active %}
+    <article class="watch-card h1-card">
+      <div class="candidate-head">
+        <div>
+          <h3>{{ entry.display.security_name }}</h3>
+          <div class="mono small">{{ entry.display.security_id }} · {{ entry.scenario_label }} · {{ entry.display.fixture_id }}</div>
+        </div>
+        <div class="badge-stack">
+          <span class="pill pill-good">{{ entry.status_label }}</span>
+          <span class="pill pill-neutral">版本 {{ entry.display.version }} / {{ entry.version_count }}</span>
+          <span class="pill pill-{{ entry.display.exit_tone }}">{{ entry.display.exit_status_label }}</span>
+        </div>
+      </div>
+
+      {% if entry.display.needs_review %}
+      <div class="notice warning h1-compact-notice">
+        <strong>已更正</strong>
+        <span>{{ entry.display.review_note }}</span>
+      </div>
+      {% endif %}
+
+      <div class="h1-grid">
+        <section class="snapshot-box">
+          <h4>静态估值 · 合成原始参考价</h4>
+          <dl class="facts">
+            <div><dt>当前版本</dt><dd>V{{ entry.display.version }} · 记录于 {{ entry.display.created_at }}</dd></div>
+            <div><dt>数量</dt><dd>{{ entry.display.quantity_text }} 股</dd></div>
+            <div><dt>平均成本</dt><dd>{{ entry.display.average_cost_text }} 元/股</dd></div>
+            <div><dt>成本基准日</dt><dd>{{ entry.display.cost_basis_date }}</dd></div>
+            <div><dt>持有交易日</dt><dd>{{ entry.display.holding_days_text }}</dd></div>
+            <div>
+              <dt>参考价</dt>
+              <dd>
+                {{ entry.display.reference_price_text }}
+                <span class="pill {{ 'pill-warn' if entry.display.price_is_stale else 'pill-bad' if entry.display.price_is_missing else 'pill-good' }}">{{ entry.display.price_status_label }}</span>
+              </dd>
+            </div>
+            <div><dt>参考价日期</dt><dd>{{ entry.display.reference_price_date or 'UNKNOWN' }}（{{ entry.display.price_basis }}）</dd></div>
+            <div><dt>静态市值</dt><dd>{{ entry.display.market_value_text }}</dd></div>
+            <div><dt>参考成本</dt><dd>{{ entry.display.cost_value_text }}</dd></div>
+            <div><dt>静态浮盈</dt><dd class="{{ 'warning-text' if entry.display.unrealized_pnl and entry.display.unrealized_pnl.startswith('-') else '' }}">{{ entry.display.unrealized_pnl_text }}</dd></div>
+            <div><dt>浮盈率</dt><dd>{{ entry.display.unrealized_pnl_rate_text }}</dd></div>
+            <div><dt>估值状态</dt><dd>{{ entry.display.valuation_status_label }}</dd></div>
+          </dl>
+          <p class="small muted">{{ entry.display.price_note }}</p>
